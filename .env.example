# ─── Required ─────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ─── Optional ─────────────────────────────────────────────
# Required only for automated GitHub PR creation
GITHUB_TOKEN=your_github_token_here

# Groq models used by the agent (defaults shown are current, non-deprecated models).
# GROQ_MODEL_STRONG handles bug detection / fix generation / repo analysis.
# GROQ_MODEL_FAST handles cheap, low-stakes calls (reflection, retry/stop planning).
GROQ_MODEL_STRONG=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b

# URL of the MCP tool server (default: http://localhost:9000/tool)
MCP_URL=http://localhost:9000/tool

# URL of the FastAPI backend (used by Streamlit)
BACKEND_URL=http://localhost:8000

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Tuning parameters
MAX_ANALYSIS_FILES=30
MAX_FIX_LINES=150
MAX_RETRIES=3
MCP_TIMEOUT=30
TEST_TIMEOUT=300
