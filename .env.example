# ─── Required ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ─── GitHub (optional — only for automated PR creation) ───────────────────────
GITHUB_TOKEN=your_github_token_here

# ─── Groq models ──────────────────────────────────────────────────────────────
# Current recommended models (Groq migration, June 2026):
#   openai/gpt-oss-120b  → replaces llama-3.3-70b-versatile (strong)
#   openai/gpt-oss-20b   → replaces llama-3.1-8b-instant   (fast)
GROQ_MODEL_STRONG=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b

# ─── LangSmith tracing (optional but highly recommended) ──────────────────────
# Get your API key at: https://smith.langchain.com
# Once set, every LangChain/LangGraph/Groq LLM call is automatically traced.
# View traces at: https://smith.langchain.com/projects/repomind-ai
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=repomind-ai
LANGSMITH_TRACING=true

# ─── Redis (optional but recommended for production) ──────────────────────────
# Used for:
#   1. Caching repo analysis results (skip re-clone on same repo)
#   2. Persistent bug+fix memory (survives restarts)
#   3. Rate-limit tracking per repo URL
#
# Local:       redis://localhost:6379
# Upstash:     rediss://:<password>@<host>:6380
# Redis Cloud: redis://:<password>@<host>:<port>
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL=3600

# ─── URLs ─────────────────────────────────────────────────────────────────────
MCP_URL=http://localhost:9000/tool
BACKEND_URL=http://localhost:8000

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── Tuning ───────────────────────────────────────────────────────────────────
MAX_ANALYSIS_FILES=30
MAX_FIX_LINES=150
MAX_RETRIES=3
MCP_TIMEOUT=30
TEST_TIMEOUT=300

# ─── Security ────────────────────────────────────────────────────────────────
# Keep MCP/Redis private; docker-compose exposes only the Streamlit frontend.
CORS_ALLOWED_ORIGINS=http://localhost:7860,http://localhost:8501
REPO_WORKSPACE_ROOT=/tmp/repomind_repos
# Generated code should only run in a dedicated external sandbox when enabled.
RUN_RUNTIME_VALIDATION=false
